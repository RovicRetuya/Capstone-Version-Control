{
	"manifest_version": 3,
	"name": "DeFaketive",
	"version": "0.1.0",
	"description": "See what buyers report about a Lazada PH or Shopee PH product: safety problems, faults and fakes. A student research project, not affiliated with Lazada or Shopee.",
	"minimum_chrome_version": "111",
	"icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png" },
	"action": { "default_title": "DeFaketive", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
	"background": { "service_worker": "background.js" },
	"permissions": ["storage"],
	"host_permissions": ["http://localhost:5173/*"],
	"content_scripts": [
		{ "matches": ["https://www.lazada.com.ph/products/*"], "js": ["collect.js", "lazada-page.js"], "world": "MAIN", "run_at": "document_idle" },
		{ "matches": ["https://www.lazada.com.ph/products/*"], "js": ["lazada.js"], "run_at": "document_idle" },
		{ "matches": ["https://shopee.ph/*"], "js": ["shopee-collect.js", "shopee-page.js"], "world": "MAIN", "run_at": "document_idle" },
		{ "matches": ["https://shopee.ph/*"], "js": ["shopee.js"], "run_at": "document_idle" },
		{ "matches": ["http://localhost:5173/*"], "js": ["site.js"], "run_at": "document_start" }
	]
}
